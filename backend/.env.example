# Agentic CRM - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string (async)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# REQUIRED - no default, must be set in production
DATABASE_URL=

# ===========================================
# REDIS
# ===========================================
# Celery message broker and result backend
REDIS_URL=redis://localhost:6379/0

# ===========================================
# SECURITY
# ===========================================
# Secret key for JWT tokens and session encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED - no default, must be set in production
SECRET_KEY=

# ===========================================
# SMTP / EMAIL
# ===========================================
# SMTP server for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Webhook secret for validating inbound webhooks
WEBHOOK_SECRET=your-webhook-secret-here

# ===========================================
# LINKEDIN
# ===========================================
# LinkedIn session cookies (for scraping)
# Get from browser dev tools after logging into LinkedIn
LINKEDIN_COOKIES=

# ===========================================
# APOLLO.IO (Lead Enrichment)
# ===========================================
# Get from: https://apollo.io/settings/integrations
APOLLO_API_KEY=

# ===========================================
# TWILIO (Phone)
# ===========================================
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ===========================================
# HUBSPOT (CRM Integration)
# ===========================================
# Get from: https://app.hubspot.com/settings/integrations
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=

# ===========================================
# GOOGLE ANALYTICS 4 (Server-side tracking)
# ===========================================
# Get from: https://analytics.google.com -> Admin -> Data Streams
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ===========================================
# AGENT SETTINGS
# ===========================================
# If true, outreach actions require human approval before execution
OUTREACH_REQUIRES_APPROVAL=true

# ===========================================
# RATE LIMITING
# ===========================================
# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Default rate limit for unauthenticated requests (per minute)
RATE_LIMIT_DEFAULT=100/minute

# Rate limit for authenticated requests (per minute)
RATE_LIMIT_AUTHENTICATED=1000/minute

# Rate limit for webhook endpoints (per minute)
RATE_LIMIT_WEBHOOKS=30/minute

# ===========================================
# CORS (Development)
# ===========================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# ELASTICSEARCH
# ===========================================
# Comma-separated list of Elasticsearch hosts
# ELASTICSEARCH_HOSTS=http://localhost:9200

# ===========================================
# OPEN TELEMETRY (Tracing)
# ===========================================
# OpenTelemetry collector endpoint for distributed tracing
# Leave empty to disable tracing
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ===========================================
# ML MODEL SERVICE
# ===========================================
# URL for ML model inference service
# ML_MODEL_SERVICE_URL=http://localhost:8001

# Timeout for ML inference requests (seconds)
# ML_INFERENCE_TIMEOUT=30

# ===========================================
# CELERY (Task Queue)
# ===========================================
# Broker URL for Celery task queue
# CELERY_BROKER_URL=redis://localhost:6379/0

# Result backend for Celery task results
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Time limit for Celery tasks (seconds)
# CELERY_TASK_TIME_LIMIT=300

# Number of Celery worker processes
# CELERY_WORKER_CONCURRENCY=4
