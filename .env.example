# =============================================================================
# Agentic CRM - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL password (required)
POSTGRES_PASSWORD=your_secure_password_here

# =============================================================================
# SECURITY
# =============================================================================
# Django/FastAPI secret key (required, min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP username (usually your full email address)
SMTP_USER=your-email@gmail.com

# SMTP password or app password (for Gmail, use an App Password)
SMTP_PASS=your-app-password

# =============================================================================
# LINKEDIN
# =============================================================================
# Base64-encoded LinkedIn session cookies
# Get from browser developer tools -> Application -> Cookies
LINKEDIN_COOKIES=your-linkedin-cookies-base64-encoded

# =============================================================================
# APOLLO.IO (Lead enrichment)
# =============================================================================
# Apollo.io API key for lead data enrichment
# Get from: https://apollo.io -> Settings -> Integrations -> API Key
APOLLO_API_KEY=your-apollo-api-key

# =============================================================================
# TWILIO (Phone/SMS)
# =============================================================================
# Twilio Account SID
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# =============================================================================
# CELERY (Task Queue)
# =============================================================================
# Redis URL for Celery broker (defaults to docker-compose redis service)
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# DATABASE URL (optional - constructed from POSTGRES_* vars by default)
# =============================================================================
# Full database connection string (overrides constructed URL)
# DATABASE_URL=postgresql+asyncpg://agentic_user:${POSTGRES_PASSWORD}@postgres:5432/agentic_crm

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Docker image tag (defaults to 'latest')
# TAG=latest

# Backend API URL for frontend (used in Next.js)
# NEXT_PUBLIC_API_URL=http://backend:8000

# =============================================================================
# LOGGING
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=info

# =============================================================================
# ENVIRONMENT
# =============================================================================
# deployment environment (development, staging, production)
# ENVIRONMENT=production
