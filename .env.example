# Agentic CRM - Root Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# BUILD
# ===========================================
# Docker image tag (default: latest)
TAG=latest

# ===========================================
# POSTGRESQL
# ===========================================
# Database name
POSTGRES_DB=agentic_crm
# Database user
POSTGRES_USER=postgres
# Database password (REQUIRED - change in production)
POSTGRES_PASSWORD=change-me-in-production

# ===========================================
# SECURITY
# ===========================================
# Secret key for JWT tokens and session encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ===========================================
# CELERY
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# SMTP / EMAIL
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===========================================
# WEBHOOK SECRET
# ===========================================
WEBHOOK_SECRET=your-webhook-secret-here

# ===========================================
# LINKEDIN
# ===========================================
# LinkedIn session cookies (for scraping)
LINKEDIN_COOKIES=

# ===========================================
# APOLLO.IO (Lead Enrichment)
# ===========================================
APOLLO_API_KEY=

# ===========================================
# TWILIO (Phone)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ===========================================
# GOOGLE ANALYTICS 4 (Server-side tracking)
# ===========================================
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_RFQ=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ===========================================
# HUBSPOT
# ===========================================
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# ===========================================
# CORS
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000